<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CD test - ${project}</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; color: #1b1f24; }
  h1 { font-size: 1.4rem; } code { background: #eef1f4; padding: .1rem .35rem; border-radius: 4px; }
  .ok { color: #1a7f37; font-weight: 600; }
</style>
</head>
<body>
<h1>${project}</h1>
<p class="ok">${message}</p>
<p>Commit <code id="commit">${commit}</code></p>
%{ if pipeline_url != "" ~}
<p>Pipeline <a href="${pipeline_url}">${pipeline_url}</a></p>
%{ endif ~}
<p>Test deployment only - it is destroyed by the pipeline's <code>cdtest:destroy</code> job.</p>
</body>
</html>
